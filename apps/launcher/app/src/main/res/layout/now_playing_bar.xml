<?xml version="1.0" encoding="utf-8"?>
<!-- Home's now playing bar (NowPlayingBar), between the widget shelf and the dock: the art, the track and the
     app, then play or pause, and a cross that stops the music. It slides up when something plays in the
     background and back down when it stops or is closed. Colours come from the scheme in code. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/nowBar"
        android:layout_width="560dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:id="@+id/nowInfo"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:focusable="true"
            android:clickable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/nowArt"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nowTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:fontFamily="@font/sans_medium"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/nowSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textSize="13sp"
                    android:fontFamily="@font/sans_regular"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/nowToggle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:padding="12dp"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="@string/now_playing_toggle" />

        <ImageView
            android:id="@+id/nowClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:padding="13dp"
            android:focusable="true"
            android:clickable="true"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/now_playing_close" />
    </LinearLayout>
</FrameLayout>
