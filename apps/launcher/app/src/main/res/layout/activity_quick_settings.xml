<?xml version="1.0" encoding="utf-8"?>
<!-- Control Center, opened by the remote's Settings button and by Home's sliders button: the Inputs
     dropdown's glass panel, placed under the header so it lines up on Home and sits top right over any app.
     The rows scroll when they are taller than the screen. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="105dp"
        android:layout_marginEnd="56dp"
        android:layout_marginBottom="24dp"
        android:orientation="vertical"
        android:background="@drawable/glass_panel"
        android:tag="m3:panel"
        android:padding="6dp"
        android:elevation="12dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
